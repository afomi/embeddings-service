# fly.toml app configuration file generated for touchpoints-embeddings on 2026-02-24T21:53:48-08:00
#
# See https://fly.io/docs/reference/configuration/ for information about how to use this file.
#

app = 'your-fly-app-name'
primary_region = 'iad'

[build]

[env]
  PORT = '8080'
  # generate a random token for this instance using `openssl rand -hex 32`
  EMBEDDING_API_TOKEN = 'YOUR_API_TOKEN_GOES_HERE'

[http_service]
  internal_port = 8080
  auto_stop_machines = 'stop'
  auto_start_machines = true
  min_machines_running = 1

[[http_service.checks]]
  grace_period = "600s"
  interval = "30s"
  timeout = "5s"
  method = "GET"
  path = "/health"

[[vm]]
  memory = '4gb'
  cpu_kind = 'shared'
  cpus = 2
